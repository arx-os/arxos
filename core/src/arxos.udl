namespace arxos_core {
    string hello(string name);
    string version();
    string generate_building_id();
    KeypairData generate_keypair();
    string public_key_hex(KeypairData keypair);
    ObjectPutResult put_blob(string store_path, bytes data, string? content_type);
    RootCreateResult create_root(string store_path, string building_id, sequence<string> object_cids, string seed_hex, string? message);
    string? show_root(string store_path, string root_cid);

    // Phase 1 — building repository + capture loop
    BuildingSummary init_building(string store_path, string? name);
    BuildingSummary open_building(string store_path, string building_id);
    sequence<BuildingSummary> list_buildings(string store_path);
    CapturePutResult capture_space(string store_path, string building_id, string? name, f64 x, f64 y, f64 z);
    CapturePutResult capture_annotation(string store_path, string building_id, string text, f64 x, f64 y, f64 z);
    CapturePutResult capture_point_cloud(string store_path, string building_id, bytes points_xyz_f32_le, f64 x, f64 y, f64 z);
    CommitSummary commit_building(string store_path, string building_id, string? message);
    sequence<AnnotationOverlay> annotations_near(string store_path, string building_id, f64 x, f64 y, f64 z, f64 radius_m);
};

dictionary KeypairData {
    bytes seed;
    string public_key_hex;
};

dictionary ObjectPutResult {
    string cid;
    string object_type;
};

dictionary RootCreateResult {
    string root_cid;
    string building_id;
    u64 object_count;
};

dictionary BuildingSummary {
    string building_id;
    string? name;
    string? head_root;
    string? building_object;
    u64 staged_count;
};

dictionary CapturePutResult {
    string cid;
    string object_type;
};

dictionary CommitSummary {
    string root_cid;
    string building_id;
    u64 object_count;
    string? previous_root;
};

dictionary AnnotationOverlay {
    string cid;
    string text;
    f64 x;
    f64 y;
    f64 z;
    f64 distance_m;
};
