[Unit]
Description=Arxos edge node (CAS + optional net serve)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=arxos
Group=arxos
Environment=ARXOS_STORE=/var/lib/arxos/store
# Serve the local object store over Iroh. Ticket is $ARXOS_STORE/meta/serve.ticket
# (0600); stdout does not print the full ticket. Do not stop this unit to apply
# the inbox — `arx inbox apply` uses meta/serve.sock.
ExecStart=/usr/local/bin/arxos-edge --store ${ARXOS_STORE} serve
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/arxos
PrivateTmp=true
UMask=0077

[Install]
WantedBy=multi-user.target
