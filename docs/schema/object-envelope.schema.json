{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arxos.dev/schema/v1/object-envelope.schema.json",
  "title": "Arxos Object Envelope",
  "description": "Documentation schema for Arxos content-addressed objects (Phase 0). Wire format is CBOR, not JSON.",
  "type": "object",
  "required": ["header", "body"],
  "additionalProperties": false,
  "properties": {
    "header": {
      "type": "object",
      "required": ["object_type", "schema_version", "created"],
      "additionalProperties": false,
      "properties": {
        "object_type": {
          "type": "string",
          "enum": [
            "building",
            "floor",
            "space",
            "surface",
            "opening",
            "equipment",
            "system",
            "circuit",
            "sensor",
            "fixture",
            "annotation",
            "point_cloud_chunk",
            "mesh",
            "bounding_volume",
            "relationship",
            "spatial_index_node",
            "root",
            "provenance",
            "blob"
          ]
        },
        "schema_version": {
          "type": "integer",
          "minimum": 1
        },
        "created": {
          "type": "integer",
          "minimum": 0,
          "description": "Unix timestamp in seconds"
        },
        "author": {
          "type": ["string", "null"],
          "description": "ed25519 public key (ed25519:hex or raw in CBOR)"
        },
        "signature": {
          "type": ["object", "null"],
          "required": ["public_key", "signature"],
          "properties": {
            "public_key": { "type": "string" },
            "signature": { "type": "string" }
          }
        }
      }
    },
    "body": {
      "type": "object",
      "required": ["kind", "data"],
      "properties": {
        "kind": {
          "type": "string",
          "description": "Must match header.object_type"
        },
        "data": {
          "type": "object",
          "description": "Type-specific payload; see object-schema.md"
        }
      }
    }
  }
}
